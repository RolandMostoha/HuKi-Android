        <shape>
            <solid android:color="@color/colorBackground" />
            <corners android:radius="@dimen/okt_routes_stamp_card_corner_size" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/colorOktStampCard" />
