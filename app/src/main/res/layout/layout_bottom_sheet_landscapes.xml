<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/DefaultBottomSheet"
    android:layout_width="match_parent"
    android:layout_height="@dimen/landscapes_bottom_sheet_peek_height"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    app:behavior_hideable="true"
    app:behavior_peekHeight="@dimen/landscapes_bottom_sheet_peek_height"
    app:behavior_saveFlags="all">

    <!-- DragView -->
    <View
        android:id="@+id/landscapesDragView"
        style="@style/DragViewStyle"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/space_medium" />

    <!-- Header -->
    <include
        android:id="@+id/landscapesHeaderContainer"
        layout="@layout/view_bottom_sheet_header" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_extra_extra_small"
        android:background="@color/colorDivider" />

    <!-- Landscapes list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/landscapesList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:nestedScrollingEnabled="true"
        android:paddingBottom="@dimen/space_large"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_landscapes" />

</LinearLayout>
