<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/newFeaturesBottomSheetContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/background_bottom_sheet"
    android:orientation="vertical"
    android:paddingBottom="@dimen/space_medium">

    <View
        style="@style/DragViewStyle"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/space_medium"
        android:layout_marginBottom="@dimen/space_small" />

    <LinearLayout
        android:id="@+id/newFeaturesHeaderContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_extra_large"
        android:layout_marginEnd="@dimen/space_medium"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="@dimen/home_search_bar_app_icon_size"
            android:layout_height="@dimen/home_search_bar_app_icon_size"
            android:layout_marginEnd="@dimen/space_medium"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_launcher_small" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/newFeaturesTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/new_features_title"
                android:textAppearance="@style/DefaultTextAppearance.Bold.Large" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_small"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/newFeaturesVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/background_new_features_version"
                    android:paddingHorizontal="@dimen/space_small_medium"
                    android:paddingVertical="3dp"
                    android:textAppearance="@style/DefaultTextAppearance.Bold.Small"
                    android:textColor="@color/colorPrimary"
                    tools:text="v1.2.0" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/newFeaturesReleaseDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_small_medium"
                    android:textAppearance="@style/DefaultTextAppearance.Regular.ExtraSmall"
                    android:textColor="@color/colorSecondaryText"
                    tools:text="May 2026" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/newFeaturesSupporterCard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_medium"
                    android:visibility="gone"
                    app:cardCornerRadius="@dimen/default_corner_size_info_card"
                    app:cardElevation="0dp"
                    app:contentPaddingTop="@dimen/space_small"
                    app:contentPaddingBottom="@dimen/space_small"
                    app:contentPaddingLeft="@dimen/space_small_medium"
                    app:contentPaddingRight="@dimen/space_small_medium"
                    app:strokeWidth="@dimen/default_highlighted_card_stroke_width"
                    tools:visibility="visible">

                    <ImageView
                        android:id="@+id/newFeaturesSupporterBadgeImage"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        tools:src="@drawable/ic_product_squirrel" />

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/newFeaturesCloseButton"
            style="@style/DefaultButton.BottomSheetAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:icon="@drawable/ic_bottom_sheet_clear" />

    </LinearLayout>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/newFeaturesMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_extra_large"
        android:layout_marginTop="@dimen/space_medium"
        android:lineSpacingExtra="3dp"
        android:textAppearance="@style/DefaultTextAppearance.Regular.Small"
        tools:text="- OKT utak és bélyegzőhelyek frissítése\n- Támogatás funkció" />

    <LinearLayout
        android:id="@+id/newFeaturesFacebookContainer"
        android:background="@drawable/background_new_features_facebook"
        android:gravity="center_vertical"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_extra_large"
        android:layout_marginTop="@dimen/space_large"
        android:layout_marginBottom="@dimen/space_medium"
        android:layout_width="match_parent"
        android:orientation="horizontal"
        android:padding="@dimen/space_large">

        <com.google.android.material.card.MaterialCardView
            android:layout_height="44dp"
            android:layout_width="44dp"
            app:cardBackgroundColor="@color/colorFacebook"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp">

            <ImageView
                android:importantForAccessibility="no"
                android:layout_gravity="center"
                android:layout_height="28dp"
                android:layout_width="28dp"
                android:src="@drawable/ic_facebook"
                app:tint="@android:color/white" />

        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_medium"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:orientation="vertical">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/newFeaturesFacebookTitle"
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:text="@string/facebook_follow_title"
                android:textAppearance="@style/DefaultTextAppearance.Bold.Small" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/newFeaturesFacebookMessage"
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:text="@string/facebook_follow_message"
                android:textAppearance="@style/DefaultTextAppearance.Regular.ExtraSmall" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            style="@style/DefaultButton.Contained.Shadowless.Primary.Small"
            android:id="@+id/newFeaturesFacebookJoinButton"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_medium"
            android:layout_width="wrap_content"
            android:paddingHorizontal="@dimen/space_large"
            android:paddingVertical="@dimen/space_small_medium"
            android:text="@string/facebook_follow_button" />

    </LinearLayout>

</LinearLayout>
