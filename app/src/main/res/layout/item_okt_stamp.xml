<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/oktStampItemContainer"
    android:layout_width="@dimen/okt_routes_stamp_card_width"
    android:layout_height="@dimen/okt_routes_stamp_card_height"
    android:layout_marginEnd="@dimen/space_small_medium"
    android:background="@drawable/background_okt_stamp_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:padding="@dimen/space_medium">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/oktStampItemIcon"
            android:layout_width="@dimen/okt_routes_stamp_icon_size"
            android:layout_height="@dimen/okt_routes_stamp_icon_size"
            android:background="@drawable/background_okt_stamp_icon"
            android:importantForAccessibility="no"
            android:padding="@dimen/space_small_medium"
            android:src="@drawable/ic_okt_stamp"
            app:tint="@color/selector_okt_stamp_icon_color" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/oktStampItemDistance"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:textAppearance="@style/DefaultTextAppearance.SemiBold.Small"
            android:textColor="@color/selector_okt_stamp_subtitle_color"
            tools:text="4.1 km" />

    </LinearLayout>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/oktStampItemTitle"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_small"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="bottom"
        android:maxLines="2"
        android:textAppearance="@style/DefaultTextAppearance.SemiBold.Medium"
        android:textColor="@color/selector_okt_stamp_title_color"
        android:textSize="@dimen/okt_routes_stamp_title_text_size"
        app:autoSizeMaxTextSize="@dimen/text_size_medium"
        app:autoSizeMinTextSize="@dimen/text_size_extra_small"
        app:autoSizeStepGranularity="1sp"
        app:autoSizeTextType="uniform"
        tools:text="Kőszeg, Jurisics tér" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/oktStampItemTag"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_extra_small"
        android:ellipsize="middle"
        android:fontFamily="monospace"
        android:singleLine="true"
        android:textAppearance="@style/DefaultTextAppearance.Regular.ExtraSmall"
        android:textColor="@color/selector_okt_stamp_subtitle_color"
        android:textSize="@dimen/okt_routes_stamp_tag_text_size"
        tools:text="OKTPH_03" />

</LinearLayout>
